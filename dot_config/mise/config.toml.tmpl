[tools]
# --- lean set: installed everywhere, incl. Linux dev containers ---
neovim = "latest"
node = "latest"
# Pinned, not "latest", so an upgrade is a deliberate step: lean-ctx rewrites
# ~/.claude/CLAUDE.md, ~/.claude/settings.json, ~/.zshrc and ~/.zshenv whenever a
# new version's server starts, and the source here has to be brought in line by
# hand (see AGENTS.md), incl. the version in the three lean-ctx hook paths in
# dot_claude/private_settings.json.tmpl. The github backend, not
# npm:lean-ctx-bin: that package's postinstall always downloads GitHub's
# *latest* binary, so its pin did not hold (a rebuild of "3.10.4" got 3.11.4).
"github:yvgude/lean-ctx" = "3.10.4"
ripgrep = "latest"
fzf = "latest"
"github:sharkdp/bat" = "0.26.1"
eza = "latest"
zoxide = "latest"
yq = "4.44.5"
lazygit = "latest"
gh = "latest"
glab = "latest"
zellij = "latest"
kind = "latest"
starship = "latest"
claude = "latest"        # native binary via aqua backend (no node dependency)
pi = "latest"            # pi coding agent (earendil-works/pi)
# kubernetes tooling (wanted in containers too)
kubectl = "1.29.11"
"aqua:derailed/k9s" = "0.32.7"
helm = "4.3.0"

{{- if not (env "DEVCONTAINER") }}

# --- full set: real hosts, macOS + Linux VMs (heavy: go/python/terraform/k8s).
# Skipped in dev containers, which stay lean. DEVCONTAINER=1 is exported in
# the Dockerfile (.devcontainer/Dockerfile:18). Non-empty string test, so
# DEVCONTAINER=0 also selects the lean set.
argocd = "2.13.1"
"github:anomalyco/opencode" = "latest"
go = "1.23.3"
"go:github.com/DarthSim/hivemind" = "latest"
gomigrate = "4.18.1"
"github:loft-sh/devpod" = { version = "latest", no_app = true }
kustomize = "latest"
opencode = "latest"
fnox = "latest"
python = "3.13.0"
sops = "3.9.2"
terraform = "1.10.1"
vault = "2.2.0"
uv = "latest"
yamllint = "1.37.0"
"pipx:commitizen" = "latest"
"pipx:graphifyy" = "latest"   # /graphify codebase knowledge graph (binary: graphify)
poetry = "latest"
zarf = "latest"
{{- end }}

[settings]
experimental = true
# `mise install` aborts with "No GitHub artifact attestations found for
# python@3.13.0" on a fresh box: python-build-standalone's older releases have no
# attestation to verify, and one failed tool fails the whole run — which takes
# run_once_after_10 (set -eu) and the entire bootstrap with it. Verification of
# every other backend (aqua, github) is untouched.
python.github_attestations = false

[env]
# Machine-local env (KUBECONFIG, trusted paths, secrets) lives in
# conf.d/secrets.local.toml — git/chezmoi ignored. Do not add machine paths here.
HUNT_EDITOR = "nvim"
HUNT_PREVIEW_SIZE = "50"
FZF_DEFAULT_OPTS = "--layout=reverse --style full --color=fg:#EFF0EB,header:#FF6AC1,info:#9AEDFE,pointer:#FF6AC1 --color=marker:#5AF78E,fg+:#EFF0EB,prompt:#57C7FF,hl+:#FF6AC1"
