{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "caveman@caveman": true,
    "clangd-lsp@claude-plugins-official": true,
    "claude-hud@claude-hud": true,
    "dx@ykdojo": true,
    "gopls-lsp@claude-plugins-official": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "repo": "JuliusBrussee/caveman",
        "source": "github"
      }
    },
    "claude-code-warp": {
      "source": {
        "repo": "warpdotdev/claude-code-warp",
        "source": "github"
      }
    },
    "claude-hud": {
      "source": {
        "repo": "jarrodwatts/claude-hud",
        "source": "github"
      }
    },
    "mem0-plugins": {
      "source": {
        "repo": "mem0ai/mem0",
        "source": "github"
      }
    },
    "ykdojo": {
      "source": {
        "repo": "ykdojo/claude-code-tips",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true",
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/share/mise/shims/lean-ctx\" hook observe",
            "type": "command"
          }
        ],
        "matcher": ".*"
      },
      {
        "hooks": [
          {
            "command": "/Users/bas/.local/share/mise/installs/npm-lean-ctx-bin/3.10.2/node_modules/.mise/lean-ctx-bin@3.10.2/node_modules/lean-ctx-bin/bin/lean-ctx hook read-dedup",
            "type": "command"
          }
        ],
        "matcher": "Read"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/share/mise/shims/lean-ctx\" hook observe",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/vault-write-guard.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash|mcp__lean-ctx__ctx_shell|mcp__lean-ctx__ctx_edit"
      },
      {
        "hooks": [
          {
            "command": "/Users/bas/.local/share/mise/installs/npm-lean-ctx-bin/3.10.2/node_modules/.mise/lean-ctx-bin@3.10.2/node_modules/lean-ctx-bin/bin/lean-ctx hook rewrite",
            "type": "command"
          }
        ],
        "matcher": "Bash|bash"
      },
      {
        "hooks": [
          {
            "command": "/Users/bas/.local/share/mise/installs/npm-lean-ctx-bin/3.10.2/node_modules/.mise/lean-ctx-bin@3.10.2/node_modules/lean-ctx-bin/bin/lean-ctx hook redirect",
            "type": "command"
          }
        ],
        "matcher": "Read|read|ReadFile|read_file|View|view|Grep|grep|Search|search|ListFiles|list_files|ListDirectory|list_directory|Glob|glob"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/share/mise/shims/lean-ctx\" hook observe",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/share/mise/shims/node\" \"$HOME/.claude/hooks/caveman-activate.js\"",
            "statusMessage": "Loading caveman mode...",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/share/mise/shims/lean-ctx\" hook observe",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/share/mise/shims/lean-ctx\" hook observe",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/share/mise/shims/node\" \"$HOME/.claude/hooks/caveman-mode-tracker.js\"",
            "statusMessage": "Tracking caveman mode...",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/share/mise/shims/lean-ctx\" hook observe",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "model": "opus",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    }
