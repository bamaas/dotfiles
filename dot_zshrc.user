#!/usr/bin/env bash

# aliasses
alias vim="nvim "
alias m="mise "
alias g="git "
alias d="docker "
alias mr="mise run "
alias v="nvim "
alias mconfig="neovim ~/.zshrc"
alias cat="bat --no-pager --style plain"
alias h="hunt "
alias ask="claude -p "
alias ls="eza"


# functions
# --- Quickly ask questions ---
q(){
  claude --model opus -p "$*"
}


# pbcopy / pbpaste on Linux (no-op on macOS)
if (( ! $+commands[pbcopy] )); then
  pbcopy() {
    # $(cat) drops trailing newlines, so `pwd | pbcopy` pastes without one
    local data=$(cat)
    if [[ -n $SSH_TTY || -n $SSH_CONNECTION ]]; then
      printf '\033]52;c;%s\a' "$(printf '%s' "$data" | base64 | tr -d '\n')" > /dev/tty
    elif [[ -n $WAYLAND_DISPLAY ]] && (( $+commands[wl-copy] )); then
      printf '%s' "$data" | wl-copy
    elif [[ -n $DISPLAY ]] && (( $+commands[xclip] )); then
      printf '%s' "$data" | xclip -selection clipboard
    else
      print -u2 "pbcopy: no clipboard available"; return 1
    fi
  }
fi

if (( ! $+commands[pbpaste] )); then
  pbpaste() {
    if [[ -n $WAYLAND_DISPLAY ]] && (( $+commands[wl-paste] )); then
      wl-paste --no-newline
    elif [[ -n $DISPLAY ]] && (( $+commands[xclip] )); then
      xclip -selection clipboard -o
    else
      print -u2 "pbpaste: no clipboard available (over SSH, use Cmd+V)"; return 1
    fi
  }
fi
